{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commons.nurse-ai-os.org/schemas/publication-decision.schema.json",
  "title": "External human Knowledge Pack publication decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "pack_id",
    "pack_version",
    "content_digest",
    "distribution_digest",
    "decision_maker",
    "authority_scope",
    "decision",
    "limitations",
    "unresolved_findings",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "pack_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "distribution_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision_maker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "role",
        "authority_basis"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "authority_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "decision": {
      "enum": [
        "approve",
        "reject",
        "defer"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
