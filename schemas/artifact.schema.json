{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commons.nurse-ai-os.org/schemas/artifact.schema.json",
  "title": "Knowledge Pack Markdown artifact front matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "content_unit_id",
    "title",
    "artifact_type",
    "language",
    "audiences",
    "learning_objectives",
    "source_refs",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "content_unit_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "enum": [
        "orientation",
        "lesson",
        "practice-exercise",
        "glossary",
        "assessment"
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "student-nurse",
          "staff-nurse",
          "nurse-educator",
          "nurse-leader",
          "nurse-informaticist"
        ]
      }
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
